# --- App config overrides ---------------------------------------------------
# Read by viper. The key must already exist in configs/config.yaml, otherwise it
# is ignored. Keep real secrets here, never in config.yaml -- this file is
# committed, .env is not.

APP_ENV=development # development, staging, or production

SERVER_MODE=debug # test, debug, or release

DATABASES_POSTGRES_PRIMARY_USER=postgres
DATABASES_POSTGRES_PRIMARY_PASSWORD=postgres

REDIS_CACHE_PASSWORD=

STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

# Required outside development: `openssl rand -base64 48`
AUTH_JWT_SECRET=
AUTH_SEED_ADMIN_EMAIL=
AUTH_SEED_ADMIN_PASSWORD=

# --- Local port overrides ---------------------------------------------------
# A different mechanism: these are read by docker compose, not by viper, and
# none of them belong in config.yaml. Defaults are in compose.yaml; set them
# only when another project on your machine already holds a default port.
#
# The catch is that they come in pairs -- the port compose publishes on and the
# port the app dials have to move together, or the app talks to nothing:
#
#   compose publishes     app dials
#   POSTGRES_HOST_PORT    DATABASES_POSTGRES_PRIMARY_PORT
#   REDIS_HOST_PORT       REDIS_CACHE_PORT
#   MINIO_HOST_PORT       STORAGE_ENDPOINT   (http://localhost:<port>)
#   MINIO_CONSOLE_PORT    -- browser only, nothing dials it
